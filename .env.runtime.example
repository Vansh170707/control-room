OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
GITHUB_MODELS_TOKEN=
NVIDIA_API_KEY=
NVIDIA_CHAT_MODEL=
MODAL_API_KEY=
MODAL_API_BASE_URL=https://api.us-west-2.modal.direct
BROWSER_USE_API_KEY=
BROWSER_USE_BASE_URL=https://api.browser-use.com/api/v3

# Nebula-style managed app connectors. Paste one Composio key, then connect
# Gmail, Drive, Calendar, Slack, Notion, GitHub, and Vercel from Connector Hub.
COMPOSIO_API_KEY=
COMPOSIO_USER_ID=vansh
COMPOSIO_BASE_URL=https://backend.composio.dev/api/v3.1

GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_SCOPE=models:read

# Optional direct OAuth fallback. Composio is preferred for new connectors.
# Redirect URLs must point to this local runtime:
# Google: http://127.0.0.1:8787/v1/connectors/google/callback
# Slack:  http://127.0.0.1:8787/v1/connectors/slack/callback
# Notion: http://127.0.0.1:8787/v1/connectors/notion/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# Token-based connectors can also be pasted in the UI.
VERCEL_TOKEN=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
