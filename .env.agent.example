# Also set these on Vercel as server-only env vars for deployed personal cloud
# mode. /api/issue-command uses them to queue bridge commands without exposing
# the secret in the browser bundle.
CLAWBUDDY_SUPABASE_URL=https://your-project-ref.supabase.co
CLAWBUDDY_INGEST_SECRET=replace-with-your-ingest-secret

CLAWBUDDY_AGENT_ID=alpha
CLAWBUDDY_AGENT_NAME=Agent Alpha
CLAWBUDDY_AGENT_EMOJI=🤖
CLAWBUDDY_AGENT_TYPE=Code Agent
CLAWBUDDY_AGENT_ROLE=Lead Engineer
CLAWBUDDY_AGENT_SUBTITLE=OpenClaw worker
CLAWBUDDY_AGENT_ACCENT=#10b981
CLAWBUDDY_POLL_INTERVAL_MS=5000
CLAWBUDDY_HEARTBEAT_MS=60000
CLAWBUDDY_WORKDIR=/absolute/path/to/your/agent/workspace

# Recommended for personal cloud mode. The bridge will refuse anything outside
# these command prefixes when CLAWBUDDY_REQUIRE_COMMAND_ALLOWLIST=true.
CLAWBUDDY_REQUIRE_COMMAND_ALLOWLIST=false
CLAWBUDDY_COMMAND_ALLOWLIST=
CLAWBUDDY_ALLOW_SHELL_OPERATORS=true
CLAWBUDDY_DISABLE_BUILTIN_BLOCKLIST=true

# Extra comma-separated regular expressions to block locally. The bridge also
# blocks sudo, rm -rf /, dd if=, and fork-bomb patterns by default.
CLAWBUDDY_BLOCKED_COMMAND_PATTERNS=
